# ==============================================================================
# BODHIWAVES GROWTH OS — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
PORT=8000
ENVIRONMENT=development
PROJECT_NAME="Bodhiwaves Growth OS"

# Database Configuration (PostgreSQL 18 Local / Render PostgreSQL)
DATABASE_URL=postgresql+psycopg2://bodhiwaves:bodhiwaves123@127.0.0.1:5432/bodhiwaves_erp

# MongoDB Atlas Configuration (Optional Secondary Datastore)
MONGODB_URL=
MONGODB_DB_NAME=bodhiwaves_growth_os

# Redis Configuration (Local / Managed Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# Authentication & Cryptography
SECRET_KEY=generate_a_secure_random_64_character_hex_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Super Admin Bootstrap (Never commit real production passwords)
BOOTSTRAP_SUPERADMIN_EMAIL=superadmin@bodhiwaves.com
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_NAME="Bodhiwaves Super Admin"

# Official Meta WhatsApp Cloud API Placeholders
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=bodhiwaves_webhook_verify_token_2026
META_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_MOCK_MODE=true
